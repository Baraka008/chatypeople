# Neon Postgres pooled connection string; set in Vercel Environment Variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional web-push notifications (server-side only)
VAPID_SUBJECT=mailto:YOUR_CONTACT_EMAIL
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Neon Auth values may be supplied by the Neon integration
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
